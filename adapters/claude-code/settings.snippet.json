{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["<adapter-dir>/goated_hook.py"]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["<adapter-dir>/goated_hook.py"]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Agent|Task|mcp__ccd_session__start_session|mcp__ccd_session__hand_off_to_session|Bash|PowerShell|mcp__.*__(create_pull_request|create_merge_request|push_files|create_or_update_file|delete_file|git_commit|create_commit|commit_changes|commit)",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["<adapter-dir>/goated_hook.py"]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["<adapter-dir>/goated_hook.py"]
          }
        ]
      }
    ]
  }
}
